{
    "SEED": 42,
    "DEVICE": "cuda:0",
    "NUM_WORKERS": 0,

    "DATASET_NAME": "PEMS08",
    "DATA_FILE_PATH": "PEMSdata/PEMS08/PEMS08.npz",
    "ADJ_FILE_PATH": "PEMSdata/PEMS08/adj_PEMS08.pkl",

    "INPUT_LENGTH": 12,
    "OUTPUT_LENGTH": 12,
    "NUM_NODES": 170,
    "NUM_FEATURES": 3,

    "MODEL_NAME": "STGCN",
    "MODEL": "basicts.models.STGCN",
    "RUNNER": "STGCNRunner",
    "MODEL_ARGS": {
        "Kt": 3,
        "Ks": 3,
        "blocks": [[3, 8, 8], [8, 8, 16]],
        "dropout": 0.0,
        "graph_conv_type": "cheb_conv"
    },

    "TRAIN_NUM_EPOCHS": 1,
    "TRAIN_BATCH_SIZE": 8,
    "TRAIN_LEARNING_RATE": 0.001,
    "TRAIN_WEIGHT_DECAY": 0.0001,
    "TRAIN_EARLY_STOPPING_PATIENCE": -1,

    "TRAIN_RATIO": 0.6,
    "VAL_RATIO": 0.2,
    "TEST_RATIO": 0.2,

    "VAL_BATCH_SIZE": 8,
    "TEST_BATCH_SIZE": 8,

    "LOSS_FUNCTION": "masked_mae",
    "METRICS": ["MAE", "RMSE", "MAPE"],

    "LOG_DIR": "outputs/smoke_STGCN_PEMS08",
    "SAVE_MODEL": true,
    "PRINT_FREQ": 10,

    "MAX_TRAIN_SAMPLES": null,
    "MAX_VAL_SAMPLES": null,
    "MAX_TEST_SAMPLES": null,
    "NORMALIZE": true
}