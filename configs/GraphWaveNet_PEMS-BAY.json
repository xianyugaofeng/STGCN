{
    "SEED": 42,
    "DEVICE": "cuda:0",
    "NUM_WORKERS": 2,

    "DATASET_NAME": "PEMS-BAY",
    "DATA_FILE_PATH": "PEMSdata/PEMS-BAY/PEMS-BAY.h5",
    "ADJ_FILE_PATH": "PEMSdata/PEMS-BAY/adj_PEMS-BAY.pkl",

    "INPUT_LENGTH": 12,
    "OUTPUT_LENGTH": 12,
    "NUM_NODES": 325,

    "MODEL_NAME": "GraphWaveNet",
    "MODEL": "basicts.models.GraphWaveNet",
    "RUNNER": "GraphWaveNetRunner",
    "MODEL_ARGS": {
        "supports": [],
        "aptinit": null,
        "dropout": 0.3,
        "gcn_bool": true,
        "addaptadj": true,
        "input_dim": 2,
        "output_dim": 12,
        "embed_dim": 10,
        "residual_channels": 32,
        "dilation_channels": 32,
        "skip_channels": 256,
        "end_channels": 512,
        "kernel_size": 2,
        "blocks": 4,
        "layers": 2,
        "num_nodes": 325,
        "input_length": 12,
        "output_length": 12
    },

    "ADJ_TYPE": "sym_adj",

    "TRAIN_NUM_EPOCHS": 100,
    "TRAIN_BATCH_SIZE": 64,
    "TRAIN_LEARNING_RATE": 0.001,
    "TRAIN_WEIGHT_DECAY": 0.0001,
    "TRAIN_EARLY_STOPPING_PATIENCE": 10,

    "TRAIN_RATIO": 0.7,
    "VAL_RATIO": 0.2,
    "TEST_RATIO": 0.1,
    "STEPS_PER_DAY": 288,

    "VAL_BATCH_SIZE": 64,
    "TEST_BATCH_SIZE": 64,

    "LOSS_FUNCTION": "masked_mae",
    "METRICS": ["MAE", "RMSE", "MAPE"],

    "LOG_DIR": "outputs/GraphWaveNet_PEMS-BAY",
    "SAVE_MODEL": true,
    "PRINT_FREQ": 10,

    "MAX_TRAIN_SAMPLES": null,
    "MAX_VAL_SAMPLES": null,
    "MAX_TEST_SAMPLES": null,
    "NORMALIZE": true,

    "ADD_TIME_OF_DAY": true,
    "ADD_DAY_OF_WEEK": true
}